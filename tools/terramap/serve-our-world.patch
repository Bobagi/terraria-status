+        title: 'Não foi possível carregar o mundo do servidor',
+        description: String(err),
+        placement: 'bottomRight',
+      });
+    } finally {
+      setFetchingServerWorld(false);
+    }
+  }, [handleWorldFileSelect]);
+
+  // Once on mount: loadServerWorld changes identity on every render.
+  // eslint-disable-next-line react-hooks/exhaustive-deps
